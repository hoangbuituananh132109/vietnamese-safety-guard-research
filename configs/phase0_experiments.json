{
  "version": 3,
  "locked_at": "2026-07-21",
  "contract": {
    "task": "text safety classification with optional policy-category supervision",
    "views_are_metadata_only": true,
    "binary": {
      "labels": ["safe", "unsafe"],
      "task_type": "single_label",
      "activation": "softmax",
      "loss": "categorical_cross_entropy",
      "supervision": "every P/R/PR instance"
    },
    "N23": {
      "labels": 23,
      "task_type": "multi_label",
      "activation": "independent_sigmoid",
      "loss": "masked_binary_cross_entropy",
      "supervision": "only category_scope=prompt or interaction; unavailable rows are masked, never all-zero negatives"
    },
    "E1_E2": "binary only; identical paired EN/VI IDs and identical text per ID",
    "E3_E4_E5_E7": "binary plus masked N23; retain all rows and audit scope-aware truncation",
    "truncation": {
      "P": "field head+tail",
      "R": "field head+tail",
      "PR": "prompt head plus response head+tail because target is response safety",
      "audit_required": true
    }
  },
  "global_recipe": {
    "seed": 3407,
    "lora": {
      "r": 4,
      "alpha": 8,
      "dropout": 0,
      "target_modules": "all-linear"
    },
    "optimizer": "AdamW",
    "effective_batch_target": 32,
    "physical_microbatch": "profiled on Quadro RTX 6000 23GB: E1=8, E2=32, full 8K mmBERT fixed/schema=8",
    "gradient_accumulation": "effective_batch_target / physical_microbatch",
    "checkpoint_resume_required": true,
    "length_bucket_batching_required": true,
    "selection_metric": "Nemotron valid unsafe AUPRC then binary macro-F1; N23 reported separately",
    "threshold_source": "Nemotron valid only"
  },
